# Spectra Gardens — local environment example.
# Copy to .env.local and replace placeholders. Never commit real secrets.
# Phase 2 can start and build without a database; database commands need a URL.

APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Server-only. Runtime and migration connections (Supabase ap-south-1).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/spectra_gardens
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/spectra_gardens

# Public Supabase project values. Safe to expose only with RLS configured.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Newer projects use a publishable key; legacy anon keys are also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Payments remain sandbox-only in this phase.
PAYMENT_PROVIDER=sandbox
PAYMENTS_LIVE_ENABLED=false
PAYMENT_SANDBOX_SECRET=replace-with-a-long-random-development-secret
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-development-secret
OUTBOX_WORKER_SECRET=replace-with-a-long-random-development-secret
# Signs guest-session cookies. Required in staging/production; rotating it
# invalidates existing guest holds.
GUEST_SESSION_SECRET=replace-with-a-long-random-development-secret
# Optional. If the scheduler cannot set Authorization, set CRON_SECRET and let
# Vercel Cron send it as the Bearer token. Never commit either value.
# CRON_SECRET=replace-with-a-long-random-development-secret
# Notifications stay disabled until recipients and a provider are approved.
NOTIFICATION_PROVIDER=disabled

# Operational defaults. Hold duration still needs client approval.
HOLD_DURATION_SECONDS=600
# Configure only after the client approves and publishes matching booking terms.
# BOOKING_TERMS_VERSION=approved-version-id
INVENTORY_POLL_SECONDS=20
LOG_LEVEL=info

# Must stay false in production. Fixtures are development-only.
ENABLE_DEV_FIXTURES=false
